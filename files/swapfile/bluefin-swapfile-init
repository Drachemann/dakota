#!/bin/sh
# Create the disk-backed swapfile that zswap fronts (see bluefin/zswap-config.bst).
# Idempotent: exits successfully if the swapfile already exists, the backing
# store would cost more boot time than it is worth, or the disk is too small.
# Writes through a temporary name, so a creation that is interrupted (including
# by this unit's own timeout) never leaves a file that the next boot would
# mistake for a complete swapfile.
set -eu

SWAPDIR=/var/swap
SWAPFILE="${SWAPDIR}/swapfile"
PARTFILE="${SWAPFILE}.part"
PROBEFILE="${SWAPDIR}/.write-probe"

[ -e "${SWAPFILE}" ] && exit 0

# min(MemTotal / 2, 8192) MiB
mem_kib=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
size_mib=$((mem_kib / 2048))
[ "${size_mib}" -gt 8192 ] && size_mib=8192

mkdir -p -m 0700 "${SWAPDIR}"

# Skip (not fail) when /var can't hold the swapfile plus a 1 GiB margin.
# stat, not df: uutils df (shipped via uutils-coreutils.bst) rejects
# -P combined with --output, and stat -f avoids parsing tabular output.
# Ordered before the fstype check so `just swap-audit` exercises this
# arithmetic when it runs the script inside the (overlayfs) image.
free_mib=$(( $(stat -f -c '%a' "${SWAPDIR}") * $(stat -f -c '%S' "${SWAPDIR}") / 1048576 ))
if [ "${free_mib}" -lt $((size_mib + 1024)) ]; then
    echo "bluefin-swapfile-init: ${free_mib} MiB free on /var, need $((size_mib + 1024)) MiB; skipping swapfile creation"
    exit 0
fi

# Skip on filesystems that can't back a swapfile (e.g. the virtiofs root of
# bcvk/testsuite ephemeral VMs, where swapon would fail the .swap unit).
fstype=$(stat -f -c %T "${SWAPDIR}")
case "${fstype}" in
    xfs|btrfs|ext2/ext3) ;;
    *)
        echo "bluefin-swapfile-init: ${fstype} does not support swapfiles; skipping"
        exit 0
        ;;
esac

# TERM/INT as well as EXIT: systemd kills the whole cgroup when TimeoutStartSec
# expires, dd dies on that signal, and the shell then runs this trap. A machine
# that is reset mid-write leaves the temporary files behind instead, so the next
# boot reclaims them before touching anything else.
cleanup() { rm -f "${PARTFILE}" "${PROBEFILE}"; }
trap cleanup EXIT TERM INT HUP

# Reclaim space from a creation that was interrupted by a reset.
rm -f "${PARTFILE}" "${PROBEFILE}"

# Budget the store against the measured write speed of the filesystem it lands
# on, because this unit runs on the boot critical path: swap.target is part of
# sysinit.target, so its entire write time is boot time. On a USB flash stick
# measured at ~6 MiB/s an uncapped 8 GiB store held this unit open for the whole
# 15 minute TimeoutStartSec, failed, and starved every other boot-time reader
# behind it for the duration (ldconfig took 14 minutes in one capture).
#
# Classifying the media instead of measuring it is not enough: a first attempt
# resolved /var's backing block device from mountinfo and skipped on a USB bus,
# and it mis-detected the bootc composefs deployment that the T2 acceptance
# machine boots -- the store was still created on the stick. Measuring the write
# itself cannot be fooled by an unusual mount layout, and it also does the right
# thing on slow fixed media (eMMC, network-backed storage) that a media test
# would have allowed. 32 MiB with conv=fsync is a real device write, small
# enough to cost about five seconds on the slowest stick seen so far.
PROBE_MIB=32
BUDGET_SEC=120
probe_start=$(date +%s)
dd if=/dev/zero of="${PROBEFILE}" bs=1M count="${PROBE_MIB}" conv=fsync status=none
probe_sec=$(( $(date +%s) - probe_start ))
rm -f "${PROBEFILE}"

# Skip when the projected time for the full store exceeds the budget. The
# integer-second probe only rounds down, so a fast disk (probe_sec 0) always
# proceeds and a slow one is never under-estimated.
if [ "${probe_sec}" -gt 0 ] && [ $((size_mib * probe_sec)) -gt $((PROBE_MIB * BUDGET_SEC)) ]; then
    echo "bluefin-swapfile-init: writing ${PROBE_MIB} MiB to /var took ${probe_sec}s, so ${size_mib} MiB would exceed ${BUDGET_SEC}s; skipping swapfile creation (zswap runs without a backing store)"
    exit 0
fi

touch "${PARTFILE}"
chmod 0600 "${PARTFILE}"
# btrfs requires NOCOW for swapfiles; must be set while the file is empty.
# Fails harmlessly on xfs.
chattr +C "${PARTFILE}" 2>/dev/null || true
# dd, not fallocate: xfs and btrfs reject preallocated (unwritten) extents
# at swapon time ("swapfile has holes").
dd if=/dev/zero of="${PARTFILE}" bs=1M count="${size_mib}" conv=fsync status=none
mkswap "${PARTFILE}"
mv "${PARTFILE}" "${SWAPFILE}"

trap - EXIT TERM INT HUP
echo "bluefin-swapfile-init: created ${size_mib} MiB swapfile at ${SWAPFILE}"
