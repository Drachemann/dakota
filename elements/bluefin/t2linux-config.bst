# t2linux-config 16.0.0 (MIT) — the parts of the Fedora package that are still
# meaningful in a non-dracut, non-NetworkManager-managed image.
#
# There is no upstream source tree: t2linux-config.spec generates all five of
# its files in %build with heredocs, so the three installed here are authored
# natively in files/t2linux-config/ and pinned to that spec's content.
#
# Deliberately not ported, with reasons:
#   * usr/lib/dracut/dracut.conf.d/t2linux-modules-install.conf
#     (add_drivers+=" t2bce_dma t2bce_core t2bce_vhci ") — inert in Dakota.
#     There is no dracut; the initramfs is generated by GNOME OS stages under
#     files/gnomeos/generate-initramfs/ with a hardcoded module allowlist. The
#     real mechanism is CONFIG_T2BCE_CORE=y / CONFIG_T2BCE_VHCI=y in the kernel
#     config fragment, which takes the drivers out of the allowlist's reach.
#   * usr/lib/NetworkManager/conf.d/90-network-t2-ncm.conf
#     (no-auto-default=t2_ncm) — Dakota's network stack is not configured
#     through NetworkManager conf.d, and the rule below already renames the
#     interface away from the default-naming path it guards.
#
# The udev rule keeps the interface name and nothing else. t2linux-config
# installs it without NM_UNMANAGED, so no NetworkManager behaviour is asserted
# here either.
#
# Suspend is masked. T2 suspend is not reliable: the reference image this work
# mirrors runs `systemctl mask suspend.target` and documents that suspend does
# not work on T2s, so the unit is masked here rather than left to fail at
# runtime. A symlink to /dev/null in any systemd unit search path masks a unit;
# %{indep-libdir} is used because this is image content, which leaves /etc free
# for an administrator to override deliberately.
kind: manual

sources:
  - kind: local
    path: files/t2linux-config

build-depends:
  - core/sandbox-tools.bst
  - freedesktop-sdk.bst:public-stacks/runtime-minimal.bst

variables:
  strip-binaries: ""

config:
  install-commands:
    - install -Dm644 t2linux-modules.conf "%{install-root}%{indep-libdir}/modules-load.d/t2linux-modules.conf"
    - install -Dm644 90-network-t2-ncm.rules "%{install-root}%{indep-libdir}/udev/rules.d/90-network-t2-ncm.rules"
    - install -Dm644 91-t2linux.preset "%{install-root}%{indep-libdir}/systemd/system-preset/91-t2linux.preset"
    - |
      install -d "%{install-root}%{indep-libdir}/systemd/system"
      ln -s /dev/null "%{install-root}%{indep-libdir}/systemd/system/suspend.target"
    - "%{install-extra}"
